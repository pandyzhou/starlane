# 缓存策略（Cloudflare Pages / Netlify 的 _headers 格式，构建时复制到 dist/ 根目录）

# 构建产物文件名带内容哈希，内容一变文件名就变，可安全长效缓存
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# 入口 HTML 绝不能长缓存，否则用户会一直拿到指向旧哈希资源的旧页面
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate
